NODE_ENV=production
PORT=4000
API_BASE_URL=https://54-205-31-17.sslip.io
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://www.easylearntest.tech
MONGODB_URI=
MONGODB_DB_NAME=learntest
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://54-205-31-17.sslip.io
BETTER_AUTH_TRUSTED_ORIGINS=https://www.easylearntest.tech
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_INIT_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_IPN_URL=https://54-205-31-17.sslip.io/api/v1/payments/sslcommerz/ipn
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/result
PAYMENT_FAIL_URL=http://localhost:3000/payment/result
PAYMENT_CANCEL_URL=http://localhost:3000/payment/result
PAYMENT_CURRENCY=USD
UPLOAD_STORAGE=local
UPLOAD_DIR=./private-uploads
# PDF uploads
MAX_PDF_SIZE_MB=5
MAX_PDF_FILES=1
# ZIP uploads
MAX_ZIP_SIZE_MB=50
MAX_ZIP_FILES=1
# Video uploads
MAX_VIDEO_SIZE_MB=200
MAX_VIDEO_FILES=1
# Image uploads
MAX_IMAGE_SIZE_MB=3
MAX_IMAGE_FILES=5
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Malware scanning (Bouncer) — see README "Malware scanning (Bouncer)"
# Disabled policy: uploads are stored approved but marked scanStatus=disabled (unscanned), never "clean".
# Enabled policy: BOUNCER_API_KEY is required (startup fails closed without it); uploads stay in
# private quarantine/ storage and are undownloadable until a completed scan returns verdict=clean.
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_PROVIDER=bouncer
BOUNCER_API_KEY=
BOUNCER_API_BASE_URL=https://api.usebouncer.dev
MALWARE_SCAN_TIMEOUT_MS=15000
MALWARE_SCAN_POLL_INTERVAL_MS=2000
MALWARE_SCAN_POLL_MAX_ATTEMPTS=15
MALWARE_SCAN_MAX_RETRIES=2