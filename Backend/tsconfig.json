{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022"], "outDir": "dist", "rootDir": ".", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src", "scripts", "tests", "vitest.config.ts"]
}
